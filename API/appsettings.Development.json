{
  "BrsApi": {
    "BaseUrl": "https://api.brsapi.ir/Market/Gold_Currency.php",
    "Key": ""
  },
  "Auth": {
    "JwtSecret": "local-development-secret-change-me-before-sharing",
    "Issuer": "GoldShopAPI",
    "Audience": "GoldShopClients",
    "JwtExpiryMinutes": 60,
    "MaxActiveRefreshTokens": 5,
    "RefreshTokenExpiryDays": 14
  },
  "Otp": {
    "ExpiryMinutes": 2,
    "RateLimitWindowMinutes": 10,
    "MaxRequestsPerWindow": 5,
    "CodeLength": 6
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
